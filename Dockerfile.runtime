# PingWAF Runtime-only Dockerfile
# 用于 release workflow：从预编译二进制构建最小运行时镜像
# 完整源码构建请使用 Dockerfile
# Must use trixie (glibc 2.40) because binaries job compiles on
# ubuntu-latest (glibc 2.39); bookworm (glibc 2.36) is too old.
# public.ecr.aws = AWS's official mirror of the same Docker Hub image;
# GHA runners hit Docker Hub's anonymous pull limit (429) intermittently.
FROM public.ecr.aws/docker/library/debian:trixie-slim

# SYNC: keep in lockstep with Dockerfile / ci.yml / release.yml
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -m -s /usr/sbin/nologin pingwaf \
    && mkdir -p /etc/pingwaf /var/lib/pingwaf \
    && chown -R pingwaf:pingwaf /var/lib/pingwaf /etc/pingwaf

# mimalloc runtime tuning. The binary's global allocator reads MIMALLOC_*
# options at startup. PURGE_DELAY is in MILLISECONDS; 1000 is mimalloc v3's
# own default, pinned here so memory-constrained deployments can discover
# and override it (lower values return freed pages to the OS sooner, at a
# small CPU cost). SYNC: keep in lockstep with Dockerfile / Dockerfile.perf.
ENV MIMALLOC_PURGE_DELAY=1000

COPY pingwaf /usr/local/bin/pingwaf
COPY pingwaf.toml /etc/pingwaf/pingwaf.toml

EXPOSE 80 443 9080 9090

VOLUME ["/var/lib/pingwaf"]

# ./data/cache (PINGWAF_CACHE_DIR default) and the ACME state file are
# relative paths; anchor them in the writable, volume-backed directory.
WORKDIR /var/lib/pingwaf

USER pingwaf

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:9080/healthz || exit 1

ENTRYPOINT ["pingwaf"]
CMD ["all-in-one"]

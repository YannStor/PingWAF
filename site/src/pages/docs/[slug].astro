---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { DOC_SLUGS, type DocSlug } from "../../content/schema";

export const getStaticPaths = (() =>
  DOC_SLUGS.map((slug) => ({ params: { slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params as { slug: DocSlug };
const entries = await getCollection("docs");
const entry = entries.find((candidate) => candidate.id === `en/${slug}`);

if (!entry) {
  throw new Error(`Missing documentation entry: en/${slug}.md`);
}

const { Content, headings } = await render(entry);
---
<DocsLayout
  locale="en"
  slug={slug}
  title={entry.data.title}
  description={entry.data.description}
  minutes={entry.data.minutes}
  headings={headings}
>
  <Content />
</DocsLayout>

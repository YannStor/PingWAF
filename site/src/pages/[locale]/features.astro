---
import type { GetStaticPaths } from "astro";
import FeaturesPage from "../../components/features/FeaturesPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../i18n/config";

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
---
<FeaturesPage locale={locale} />

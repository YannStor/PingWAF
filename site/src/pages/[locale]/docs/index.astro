---
import type { GetStaticPaths } from "astro";
import DocsHubPage from "../../../components/docs/DocsHubPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../../i18n/config";

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
---
<DocsHubPage locale={locale} />

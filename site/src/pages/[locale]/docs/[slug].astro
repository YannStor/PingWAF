---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";
import { DOC_SLUGS, type DocSlug } from "../../../content/schema";
import { PREFIXED_LOCALES, type Locale } from "../../../i18n/config";

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.flatMap((locale) =>
    DOC_SLUGS.map((slug) => ({ params: { locale, slug } })),
  )) satisfies GetStaticPaths;

const { locale, slug } = Astro.params as { locale: Locale; slug: DocSlug };
const entries = await getCollection("docs");
const entry = entries.find((candidate) => candidate.id === `${locale}/${slug}`);

if (!entry) {
  throw new Error(`Missing documentation entry: ${locale}/${slug}.md`);
}

const { Content, headings } = await render(entry);
---
<DocsLayout
  locale={locale}
  slug={slug}
  title={entry.data.title}
  description={entry.data.description}
  minutes={entry.data.minutes}
  headings={headings}
>
  <Content />
</DocsLayout>

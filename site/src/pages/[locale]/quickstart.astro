---
import type { GetStaticPaths } from "astro";
import QuickStartPage from "../../components/quickstart/QuickStartPage.astro";
import { PREFIXED_LOCALES, type Locale } from "../../i18n/config";

export const getStaticPaths = (() =>
  PREFIXED_LOCALES.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params as { locale: Locale };
---
<QuickStartPage locale={locale} />

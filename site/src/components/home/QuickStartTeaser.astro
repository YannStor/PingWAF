---
import Icon from "../Icon.astro";
import type { IntroContent } from "../../content/schema";
import { href } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

interface Props {
  locale: Locale;
  quickstart: IntroContent["quickstart"];
}

const { locale, quickstart } = Astro.props;
---
<section class="section section--recessed">
  <div class="container">
    <div class="teaser">
      <div class="reveal">
        <p class="eyebrow">{quickstart.eyebrow}</p>
        <h2 class="title--sm title">{quickstart.title}</h2>
        <p class="lead">{quickstart.lead}</p>

        <ol class="teaser__steps">
          {
            quickstart.steps.map((step, index) => (
              <li>
                <span class="teaser__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <strong>{step.title}</strong>
                  <p>{step.body}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="hero__actions">
          <a class="btn btn--primary" href={href(quickstart.primary.path, locale)}>
            {quickstart.primary.label}
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn--outline" href={href(quickstart.secondary.path, locale)}>
            {quickstart.secondary.label}
          </a>
        </div>
      </div>

      <div class="terminal reveal">
        <div class="terminal__bar">
          <div class="shot__dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span class="terminal__title">{quickstart.terminal.title}</span>
        </div>
        <div class="terminal__body">
          {
            quickstart.terminal.lines.map((line, index) => (
              <div class="terminal__line">
                {line.startsWith("$") ? (
                  <>
                    <span class="terminal__prompt">$</span>
                    {line.slice(1)}
                  </>
                ) : (
                  <span class={index >= 3 ? "terminal__ok" : "terminal__comment"}>{line}</span>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .teaser {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 48px;
    align-items: center;
  }

  .teaser__steps {
    display: grid;
    gap: 14px;
    margin: 28px 0;
    padding: 0;
    list-style: none;
  }

  .teaser__steps li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .teaser__index {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 999px;
    border: 1px solid var(--color-border-line);
    background: var(--color-bg-base);
    font-family: var(--site-font-mono);
    font-size: 11px;
    color: var(--color-text-subtle);
  }

  .teaser__steps strong {
    font-size: 14.5px;
    color: var(--color-text-strong);
  }

  .teaser__steps p {
    margin-top: 2px;
    font-size: 13px;
    color: var(--color-text-subtle);
    line-height: 1.55;
  }

  @media (max-width: 1080px) {
    .teaser {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>

---
import Icon from "./Icon.astro";
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
---
<button
  type="button"
  class="icon-btn theme-toggle"
  aria-label={ui.common.toggleTheme}
  title={ui.common.toggleTheme}
  data-theme-toggle
>
  <span class="theme-toggle__light"><Icon name="sun" /></span>
  <span class="theme-toggle__dark"><Icon name="moon" /></span>
</button>

<style>
  .theme-toggle__dark {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__light {
    display: none;
  }

  :global([data-theme="dark"]) .theme-toggle__dark {
    display: grid;
  }
</style>

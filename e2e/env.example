# Browser-facing control plane. The demo uses a self-signed dashboard cert.
E2E_BASE_URL=https://47.242.20.155:9080
E2E_ADMIN_EMAIL=admin@pingwaf.local
E2E_ADMIN_PASSWORD=set-me-at-runtime

# All test-only hostnames map to the edge without DNS:
#   --host-resolver-rules=MAP *.e2e.test 47.242.20.155
E2E_ZONE=e2e.test
E2E_EDGE_IP=47.242.20.155

# Origin container names on the demo's waf_pingwaf-net network.
E2E_ORIGIN_URL=http://e2e-origin-a:8080
E2E_ORIGIN_TLS_URL=https://e2e-origin-a:8443

# The real ACME test domain; its A record must point at E2E_EDGE_IP.
E2E_ACME_DOMAIN=mirror.liveflowhub.com
E2E_ACME_TIMEOUT=900000

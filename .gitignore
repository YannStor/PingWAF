# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock IS tracked: PingWAF ships executables (pingwaf / pingap), so the
# lock file is committed for reproducible builds. Do NOT ignore it.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Added by cargo
.vscode
node_modules
dist
dhat*.json
default_*
report.*
.shuttle*
Secrets*.toml
.claude/settings.local.json

# VitePress docs site
website/node_modules/
website/.vitepress/dist/
website/.vitepress/cache/
# Generated markdown (from scripts/build-website.sh)
website/index.md
website/plugins/
website/crates/
website/guide/
website/zh/
# Legacy docsify leftovers
website/en/
website/assets/docsify-app.js
website/assets/style.css
website/README.md
website/_sidebar.md
website/_navbar.md
.gstack/

# tsc -b incremental caches, rewritten by every web build
web/*.tsbuildinfo

# Local environment / runtime files — never commit
.env
.env.*
*.log
data/

# Local certificates & private keys (the Let's Encrypt root certs in
# pingap-certificate/assets/ are public and stay tracked by git)
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Qoder IDE internal repowiki/metadata
.qoder/

# ─── Node / frontend ──────────────────────────────────────────────────────────
# `node_modules`, `dist` and `web/*.tsbuildinfo` are already covered above; the
# entries below add coverage reports and the various package-manager debug logs.
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Environment / secrets ────────────────────────────────────────────────────
# `.env` and `.env.*` are ignored above; keep a shareable example tracked.
!.env.example

# ─── Runtime data & logs ──────────────────────────────────────────────────────
/var/

# ─── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/

# ─── Local build-output binaries dropped at the repo root ─────────────────────
# Leading slash anchors these to the repo root only, so a stray compiled binary
# is ignored while source dirs (pingwaf-server/, pingap-core/, ...) and files
# like pingwaf.toml / pingwaf.service are untouched.
/pingwaf
/pingap

# Python bytecode from tools/waf-bench scripts
__pycache__/

# Internal review notes — never publish
docs-internal/

# WorkBuddy local session memory & workspace data
.workbuddy/

# Session-local plan artifacts; agents/rules below are shared project config.
.codebuddy/plans/

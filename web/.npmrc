# Fail instead of warning when the runtime misses `engines.node` (package.json).
#
# The dashboard is built with Node 26.12.1 or newer: 26.12.1 is the security
# release that patches the October 2026 advisories (CVE-2026-111497 among
# them), and CI/Dockerfile pin the same version. Without `engine-strict` npm
# would only print a warning and happily build the bundle on an older, now
# unsupported runtime.
engine-strict=true
